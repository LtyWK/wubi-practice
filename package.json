{
  "name": "wubi-learning",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:levels": "vitest run src/testing/levels.smoke.test.ts",
    "test:watch": "vitest",
    "data:build": "tsx scripts/build-chars.ts wubi86 && tsx scripts/build-zigen.ts wubi86 && tsx scripts/build-chars.ts wubi98 && tsx scripts/build-zigen.ts wubi98",
    "data:verify": "tsx scripts/verify-data.ts wubi86 && tsx scripts/verify-data.ts wubi98 && tsx scripts/verify-articles.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.18.1",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.1.10"
  }
}
